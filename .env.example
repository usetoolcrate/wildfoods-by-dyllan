# Set in Vercel (Production). Pull with `vercel env pull` for local API work.
# Neon Postgres connection string (recipes, questionnaire answers)
DATABASE_URL=
# Vercel Blob token (recipe photo uploads)
BLOB_READ_WRITE_TOKEN=
# Password for /admin/recipes and /admin/questions
ADMIN_PASSWORD=
# Random string that signs the admin session cookie
SESSION_SECRET=
